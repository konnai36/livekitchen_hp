# Mail transport for the website notification worker.
# Copy this file to /etc/italian-school-mail.env, owned by root with mode 0600.
# Do not commit real SMTP credentials.
# Configure and verify the host's sendmail SMTP relay first.
# MAIL_FROM must be a real, verified sender accepted by that relay.
MAIL_SENDMAIL_ENABLED=true
MAIL_FROM=
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail

# Public address and owner notification address for this website.
# This is read by site.config.cjs and notify.cjs; it may differ per website.
CONTACT_EMAIL=livekitchen.co@gmail.com
