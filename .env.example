# Per-website public settings. Put real values in the systemd EnvironmentFile,
# not in the repository. Use one set of values for each single-tenant website.

# The address shown on this website and used for owner notifications.
CONTACT_EMAIL=livekitchen.co@gmail.com

# Central multi-tenant case-management system.
# All websites may use the same API URL; the API key and tenant slug identify
# which tenant receives the inquiry. Never expose the API key to browser code.
CASE_SYSTEM_API_URL=http://127.0.0.1:8235/api/v1/inquiries
CASE_SYSTEM_TENANT_SLUG=livekitchen
CASE_SYSTEM_API_KEY=replace-with-the-api-key-issued-for-this-tenant

# Private inquiry storage used by this website's local outbox.
CONTACT_STATE_DIR=/var/lib/italian-school
